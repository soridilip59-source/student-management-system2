# Production deployment environment variables
PORT=5000
NODE_ENV=production

MONGO_ROOT_USERNAME=sms_admin
MONGO_ROOT_PASSWORD=replace_with_a_long_unique_password
MONGO_DATABASE=student-management-system

# JWT Configuration
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRE=7d
CORS_ORIGIN=https://your-domain.example

# Optional: set this to use MongoDB Atlas instead of the compose MongoDB service.
# MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/student-management-system?retryWrites=true&w=majority
